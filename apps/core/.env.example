# PostgreSQL. For `docker compose up`, the compose file sets DATABASE_URL automatically.
# For running Next.js directly on Windows with the compose DB, use localhost instead of db.
DATABASE_URL=postgresql://dao:dao@localhost:5432/dao

# Public URL of this application.
APP_BASE_URL=http://localhost:3000

# Telegram OIDC credentials from BotFather -> Login Widget.
TELEGRAM_OIDC_CLIENT_ID=
TELEGRAM_OIDC_CLIENT_SECRET=
# Optional; defaults to APP_BASE_URL + /api/auth/telegram/callback
TELEGRAM_OIDC_REDIRECT_URI=

# Server-side Bot API token for the same bot as TELEGRAM_OIDC_CLIENT_ID.
# Never expose this value to the browser or commit a real token.
TELEGRAM_BOT_TOKEN=
TELEGRAM_NOTIFICATIONS_ENABLED=false

# Telegram Bot API webhook ingestion. Keep the secret out of Git.
TELEGRAM_WEBHOOK_SECRET=
# Numeric chat ID of the only group/forum accepted by DAO Core (usually starts with -100).
TELEGRAM_INGEST_CHAT_ID=

# Separate Reception bot. Its webhook receives private /start and forum chat_member updates.
TELEGRAM_RECEPTION_BOT_TOKEN=
TELEGRAM_RECEPTION_WEBHOOK_SECRET=
TELEGRAM_RECEPTION_BOT_USERNAME=
# Enable /start Mini App button only after verifying the HTTPS application with Reception bot.
TELEGRAM_RECEPTION_MINI_APP_ENABLED=false
TELEGRAM_RECEPTION_PUBLICATIONS_ENABLED=false
TELEGRAM_FORUM_CHAT_ID=
TELEGRAM_RECEPTION_TOPIC_ID=
TELEGRAM_FORUM_INVITE_URL=
TELEGRAM_GUARDIAN_INVITES_ENABLED=false

# Prototype-only admin allowlist: comma-separated internal Participant UUIDs.
# This is temporary and will be replaced by a Role/Permission model.
ADMIN_PARTICIPANT_IDS=

# Institutional award authority: one internal Participant UUID, separate from technical admins.
# Empty/invalid configuration denies establishing awards and offering instances.
FOUNDER_PARTICIPANT_ID=

# Session lifetime in days.
SESSION_TTL_DAYS=30

# Local-only testing shortcut. It is forcibly disabled when NODE_ENV=production.
DEV_AUTH_BYPASS=true
