# Compose deployment identity. Keep the real .env.production on the VPS only.
CORE_DOMAIN=core.daorus.org
DAO_CORE_IMAGE_TAG=latest

# Use a long URL-safe random value (for example, 32 random bytes encoded as hex).
POSTGRES_DB=dao
POSTGRES_USER=dao
POSTGRES_PASSWORD=

APP_BASE_URL=https://core.daorus.org
TELEGRAM_OIDC_CLIENT_ID=
TELEGRAM_OIDC_CLIENT_SECRET=
TELEGRAM_OIDC_REDIRECT_URI=https://core.daorus.org/api/auth/telegram/callback
# Bot API token of the same bot as TELEGRAM_OIDC_CLIENT_ID; set only on the VPS.
TELEGRAM_BOT_TOKEN=
TELEGRAM_NOTIFICATIONS_ENABLED=false

# Optional until Telegram message ingestion is enabled in production.
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_INGEST_CHAT_ID=

# Temporary prototype admin allowlist: comma-separated internal Participant UUIDs.
ADMIN_PARTICIPANT_IDS=
SESSION_TTL_DAYS=30

# Production Compose overrides this to false as a defence-in-depth measure.
DEV_AUTH_BYPASS=false
